# Copy this file to .env and fill in your values.
#
# Found in the Zela Dashboard → Project Settings → Keys
ZELA_PROJECT_KEY_ID=your_key_client_id_here
ZELA_PROJECT_KEY_SECRET=your_key_secret_here

# Found in the Zela Dashboard → Project Settings (project UUID)
ZELA_PROJECT=your_project_uuid_here

# Found in the Zela Dashboard → Sources → leader_routing (procedure UUID)
ZELA_PROCEDURE=your_procedure_uuid_here
